---
import Icon from './Icon.astro';
import { t, type Locale } from '../i18n';
import { site } from '../data/site';

interface Props {
  locale: Locale;
  maxGuests?: number;
}

const { locale, maxGuests = 8 } = Astro.props;
const s = t(locale).contact;
const today = new Date().toISOString().slice(0, 10);
---

<form
  class="form"
  data-contact
  data-key={site.web3formsKey}
  data-email={site.email}
  data-msg-sending={s.sending}
  data-msg-success={s.success}
  data-msg-error={s.error}
  data-msg-required={s.required}
  novalidate
>
  <div class="row">
    <label class="field">
      <span>{s.name} <em>*</em></span>
      <input name="name" autocomplete="name" required />
    </label>
    <label class="field">
      <span>{s.email} <em>*</em></span>
      <input name="email" type="email" autocomplete="email" required />
    </label>
  </div>

  <div class="row row--3">
    <label class="field">
      <span>{s.arrival}</span>
      <input name="arrival" type="date" min={today} data-arrival />
    </label>
    <label class="field">
      <span>{s.departure}</span>
      <input name="departure" type="date" min={today} data-departure />
    </label>
    <label class="field">
      <span>{t(locale).villa.guests}</span>
      <span class="select">
        <select name="guests">
          <option value="">{s.any}</option>
          {Array.from({ length: maxGuests }, (_, i) => <option value={i + 1}>{i + 1}</option>)}
        </select>
        <Icon name="down" size={16} />
      </span>
    </label>
  </div>

  <label class="field">
    <span>{s.message} <em>*</em></span>
    <textarea name="message" rows="5" required></textarea>
  </label>

  <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="submit">
    <button class="btn btn--primary" type="submit">
      {s.send}
      <Icon name="arrow" size={18} />
    </button>
    <p class="status" role="status" aria-live="polite" data-status></p>
  </div>
</form>

<style>
  .form {
    display: grid;
    gap: 20px;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .row {
    align-items: end;
  }
  .row--3 {
    grid-template-columns: 1fr 1fr 1fr;
  }
  .field {
    min-width: 0;
    display: grid;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink-soft);
  }
  em {
    font-style: normal;
    color: var(--clay);
  }
  input,
  textarea,
  select {
    width: 100%;
    min-height: 52px;
    font: inherit;
    font-size: 1rem;
    font-weight: 400;
    color: var(--ink);
    background: var(--sand);
    border: 1px solid transparent;
    border-radius: 14px;
    padding: 13px 16px;
    transition:
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }
  input:hover,
  textarea:hover,
  select:hover {
    border-color: var(--stone);
  }
  input:focus,
  textarea:focus,
  select:focus {
    outline: none;
    background: #fff;
    border-color: var(--clay);
    box-shadow: 0 0 0 4px rgba(164, 81, 47, 0.12);
  }
  input,
  select {
    height: 52px;
    min-width: 0;
  }
  textarea {
    resize: vertical;
    min-height: 140px;
  }
  .select {
    position: relative;
    display: block;
  }
  select {
    appearance: none;
    padding-right: 40px;
    cursor: pointer;
  }
  .select :global(svg) {
    position: absolute;
    right: 16px;
    top: 50%;
    translate: 0 -50%;
    pointer-events: none;
    color: var(--ink-soft);
  }
  .hp {
    display: none;
  }
  .submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 4px;
  }
  .status {
    font-size: 0.95rem;
  }
  .status.is-error {
    color: #9b2c1c;
  }
  .status.is-success {
    color: var(--olive-deep);
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .row,
    .row--3 {
      grid-template-columns: 1fr;
    }
    .submit .btn {
      width: 100%;
    }
  }
</style>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-contact]')) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const arrival = form.querySelector<HTMLInputElement>('[data-arrival]')!;
    const departure = form.querySelector<HTMLInputElement>('[data-departure]')!;
    const d = form.dataset;

    // No dates in the past (the build-time value may be stale); departure can't be before arrival.
    arrival.min = departure.min = new Date().toISOString().slice(0, 10);
    arrival.addEventListener('change', () => {
      departure.min = arrival.value || departure.min;
      if (departure.value && departure.value < arrival.value) departure.value = '';
    });

    const setStatus = (msg: string, kind?: 'error' | 'success') => {
      status.textContent = msg;
      status.className = 'status' + (kind ? ` is-${kind}` : '');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const get = (k: string) => String(data.get(k) ?? '').trim();
      const name = get('name');
      const email = get('email');
      const message = get('message');
      if (!name || !email || !message || !form.checkValidity()) {
        setStatus(d.msgRequired!, 'error');
        return;
      }

      const dates = [get('arrival'), get('departure')].filter(Boolean).join(' → ');
      const guests = get('guests');
      const subject = `Website enquiry from ${name}`;
      const body = [message, '', dates && `Dates: ${dates}`, guests && `Guests: ${guests}`, `From: ${name} <${email}>`]
        .filter((l) => l !== '')
        .join('\n');

      // No form service configured yet: hand over to the visitor's email app.
      if (!d.key) {
        location.href = `mailto:${d.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        return;
      }

      button.disabled = true;
      setStatus(d.msgSending!);
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: d.key,
            subject,
            from_name: 'Belle Helene website',
            name,
            email,
            dates,
            guests,
            message,
            botcheck: data.get('botcheck') ? true : '',
          }),
        });
        const json = await res.json();
        if (!res.ok || !json.success) throw new Error(json.message);
        form.reset();
        setStatus(d.msgSuccess!, 'success');
      } catch {
        setStatus(d.msgError!, 'error');
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
