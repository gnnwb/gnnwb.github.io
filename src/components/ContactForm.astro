---
import Icon from './Icon.astro';
import { t, type Locale } from '../i18n';
import { site } from '../data/site';

interface Props {
  locale: Locale;
  maxGuests?: number;
  /** "booking" asks for dates (required) and a phone number, and sends a booking request. */
  variant?: 'message' | 'booking';
}

const { locale, maxGuests = 8, variant = 'message' } = Astro.props;
const s = t(locale).contact;
const b = t(locale).booking;
const booking = variant === 'booking';
const today = new Date().toISOString().slice(0, 10);
---

<form
  class="form"
  data-contact
  data-key={site.web3formsKey}
  data-email={site.email}
  data-msg-sending={s.sending}
  data-variant={variant}
  data-msg-success={booking ? b.success : s.success}
  data-msg-error={s.error}
  data-msg-required={booking ? b.required : s.required}
  novalidate
>
  <div class="row">
    <label class="field">
      <span>{s.name} <em>*</em></span>
      <input name="name" autocomplete="name" required />
    </label>
    <label class="field">
      <span>{s.email} <em>*</em></span>
      <input name="email" type="email" autocomplete="email" required />
    </label>
  </div>

  <div class:list={['row', { 'row--3': !booking }]}>
    <label class="field">
      <span>{s.arrival} {booking && <em>*</em>}</span>
      <input name="arrival" type="date" min={today} data-arrival required={booking} />
    </label>
    <label class="field">
      <span>{s.departure} {booking && <em>*</em>}</span>
      <input name="departure" type="date" min={today} data-departure required={booking} />
    </label>
    {!booking && (
      <label class="field">
        <span>{t(locale).villa.guests}</span>
        <span class="select">
          <select name="guests">
            <option value="">{s.any}</option>
            {Array.from({ length: maxGuests }, (_, i) => <option value={i + 1}>{i + 1}</option>)}
          </select>
          <Icon name="down" size={16} />
        </span>
      </label>
    )}
  </div>

  {booking && (
    <div class="row">
      <label class="field">
        <span>{t(locale).villa.guests} <em>*</em></span>
        <span class="select">
          <select name="guests" required>
            <option value="">{s.any}</option>
            {Array.from({ length: maxGuests }, (_, i) => <option value={i + 1}>{i + 1}</option>)}
          </select>
          <Icon name="down" size={16} />
        </span>
      </label>
      <label class="field">
        <span>{b.phone} <i>({b.optional})</i></span>
        <input name="phone" type="tel" autocomplete="tel" inputmode="tel" />
      </label>
    </div>
  )}

  <label class="field">
    {booking ? <span>{b.message} <i>({b.optional})</i></span> : <span>{s.message} <em>*</em></span>}
    <textarea name="message" rows={booking ? 3 : 5} required={!booking}></textarea>
  </label>

  <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="submit">
    <button class="btn btn--primary" type="submit">
      {booking ? b.send : s.send}
      <Icon name="arrow" size={18} />
    </button>
    <p class="status" role="status" aria-live="polite" data-status></p>
  </div>
</form>

<style>
  .form {
    display: grid;
    gap: 20px;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .row {
    align-items: end;
  }
  .row--3 {
    grid-template-columns: 1fr 1fr 1fr;
  }
  .field {
    min-width: 0;
    display: grid;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink-soft);
  }
  em {
    font-style: normal;
    color: var(--clay);
  }
  .field i {
    font-style: normal;
    font-weight: 400;
    opacity: 0.75;
  }
  input,
  textarea,
  select {
    width: 100%;
    min-height: 52px;
    font: inherit;
    font-size: 1rem;
    font-weight: 400;
    color: var(--ink);
    background: var(--sand);
    border: 1px solid transparent;
    border-radius: 16px;
    padding: 13px 16px;
    transition:
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }
  input:hover,
  textarea:hover,
  select:hover {
    border-color: var(--stone);
  }
  input:focus,
  textarea:focus,
  select:focus {
    outline: none;
    background: #fff;
    border-color: var(--clay);
    box-shadow: 0 0 0 4px rgba(181, 83, 47, 0.12);
  }
  input,
  select {
    height: 52px;
    min-width: 0;
  }
  textarea {
    resize: vertical;
    min-height: 96px;
  }
  .select {
    position: relative;
    display: block;
  }
  select {
    appearance: none;
    padding-right: 40px;
    cursor: pointer;
  }
  .select :global(svg) {
    position: absolute;
    right: 16px;
    top: 50%;
    translate: 0 -50%;
    pointer-events: none;
    color: var(--ink-soft);
  }
  .hp {
    display: none;
  }
  .submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 4px;
  }
  .status {
    font-size: 0.95rem;
  }
  .status.is-error {
    color: #9b2c1c;
  }
  .status.is-success {
    color: var(--olive-deep);
    font-weight: 600;
    animation: pop-in 0.6s var(--spring);
  }
  @keyframes pop-in {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.98);
    }
  }
  @media (max-width: 640px) {
    .row,
    .row--3 {
      grid-template-columns: 1fr;
    }
    .submit .btn {
      width: 100%;
    }
  }
</style>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-contact]')) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const arrival = form.querySelector<HTMLInputElement>('[data-arrival]')!;
    const departure = form.querySelector<HTMLInputElement>('[data-departure]')!;
    const d = form.dataset;

    // No dates in the past (the build-time value may be stale); departure can't be before arrival.
    arrival.min = departure.min = new Date().toISOString().slice(0, 10);
    arrival.addEventListener('change', () => {
      departure.min = arrival.value || departure.min;
      if (departure.value && departure.value < arrival.value) departure.value = '';
    });

    const setStatus = (msg: string, kind?: 'error' | 'success') => {
      status.textContent = msg;
      status.className = 'status' + (kind ? ` is-${kind}` : '');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const get = (k: string) => String(data.get(k) ?? '').trim();
      const booking = d.variant === 'booking';
      const name = get('name');
      const email = get('email');
      const message = get('message');
      if (!name || !email || (!booking && !message)) {
        setStatus(d.msgRequired!, 'error');
        return;
      }
      if (!form.checkValidity()) {
        // A field with its own message (e.g. dates that are already booked) explains itself.
        const custom = [...form.elements].find(
          (el): el is HTMLInputElement => el instanceof HTMLInputElement && !!el.validity.customError,
        );
        setStatus(custom?.validationMessage || d.msgRequired!, 'error');
        return;
      }

      const arrival = get('arrival');
      const departure = get('departure');
      const nights =
        arrival && departure ? Math.round((Date.parse(departure) - Date.parse(arrival)) / 86_400_000) : 0;
      const dates = [arrival, departure].filter(Boolean).join(' → ') + (nights > 0 ? ` (${nights} nights)` : '');
      const guests = get('guests');
      const phone = get('phone');
      const subject = booking
        ? `Booking request: ${dates}${guests ? `, ${guests} guests` : ''} – ${name}`
        : `Website enquiry from ${name}`;
      const body = [
        booking ? 'Booking request from the website' : message,
        '',
        dates && `Dates: ${dates}`,
        guests && `Guests: ${guests}`,
        phone && `Phone: ${phone}`,
        `From: ${name} <${email}>`,
        booking && message ? `\n${message}` : '',
      ]
        .filter((l) => l !== '')
        .join('\n');

      // No form service configured yet: hand over to the visitor's email app.
      if (!d.key) {
        location.href = `mailto:${d.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        return;
      }

      button.disabled = true;
      setStatus(d.msgSending!);
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: d.key,
            subject,
            from_name: 'Belle Helene website',
            name,
            email,
            dates,
            guests,
            phone,
            message,
            botcheck: data.get('botcheck') ? true : '',
          }),
        });
        const json = await res.json();
        if (!res.ok || !json.success) throw new Error(json.message);
        form.reset();
        form.dispatchEvent(new Event('booking:sent'));
        setStatus(d.msgSuccess!, 'success');
      } catch {
        setStatus(d.msgError!, 'error');
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
