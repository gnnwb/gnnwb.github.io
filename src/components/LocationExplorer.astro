---
// Interactive area map: category filters, a list of places and a Leaflet map that stay in sync.
// Leaflet is loaded only when the section comes near the viewport.
import 'leaflet/dist/leaflet.css';
import Icon from './Icon.astro';
import { t, type Locale } from '../i18n';
import { exploreSections, placesFor, sectionColors, type ExploreSection } from '../data/explore';
import type { Villa } from '../data/villas';
import routes from '../data/routes.json';

interface Props {
  locale: Locale;
  villa: Villa;
  eyebrow?: string;
  title?: string;
  lead?: string;
  initialSection?: ExploreSection | 'all';
  id?: string;
  light?: boolean;
}

const { locale, villa, eyebrow, title, lead, initialSection = 'all', id = 'location', light = false } = Astro.props;
const s = t(locale);
const list = placesFor(locale);

const config = {
  initial: initialSection,
  villa: { name: villa.text[locale].name, label: s.location.villaLabel, lat: villa.coords.lat, lng: villa.coords.lng, maps: villa.mapsUrl },
  directions: s.location.directions,
  colors: sectionColors,
  places: list.map(({ id, section, lat, lng, rating, title, distance, text }) => ({ id, section, lat, lng, rating, title, distance, text })),
  // Walking or driving route from the villa, drawn on the map when a place is picked.
  routes: routes as unknown as Record<string, { mode: 'walk' | 'car'; m: number; s: number; path: [number, number][] }>,
};
const counts = Object.fromEntries(exploreSections.map((sec) => [sec, list.filter((p) => p.section === sec).length]));
---

<section class:list={['section', 'loc', { 'section--light': light }]} id={id}>
  <div class="wrap">
    {
      (eyebrow || title || lead) && (
        <div class="head" data-reveal>
          {eyebrow && (
            <span class="eyebrow">
              <Icon name="pin" size={16} /> {eyebrow}
            </span>
          )}
          {title && <h2>{title}</h2>}
          {lead && <p class="lead">{lead}</p>}
          <slot name="head" />
        </div>
      )
    }

    <div class="explorer" data-explorer data-config={JSON.stringify(config)}>
      <div class="panel">
        <div class="tabs" role="toolbar" aria-label={s.nav.explore}>
          <button type="button" class="tab" data-tab="all" aria-pressed={initialSection === 'all'}>{s.location.all}</button>
          {
            exploreSections.map((sec) => (
              <button type="button" class="tab" data-tab={sec} aria-pressed={initialSection === sec} style={`--c:${sectionColors[sec]}`}>
                <span class="dot" />
                {s.explore[sec]}
                <span class="count">{counts[sec]}</span>
              </button>
            ))
          }
        </div>

        <ul class="list" data-list>
          {
            list.map((p) => (
              <li data-section={p.section} hidden={initialSection !== 'all' && initialSection !== p.section}>
                <button type="button" class="item" data-place={p.id} style={`--c:${sectionColors[p.section]}`}>
                  <span class="dot" />
                  <span class="name">{p.title}</span>
                  <span class="dist">
                    {p.rating && <b class="rating">★ {p.rating.toLocaleString(locale, { minimumFractionDigits: 1 })}</b>}
                    {p.distance}
                  </span>
                </button>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="map-wrap shape-b">
        <div class="map" data-map role="region" aria-label={s.location.mapLabel}></div>
        <div class="place-card" data-card hidden aria-live="polite">
          <button type="button" class="card-close" data-card-close aria-label={s.nav.close}>
            <Icon name="close" size={16} />
          </button>
          <div data-card-body></div>
        </div>
        <p class="hint" data-hint aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M9 11V5.5a1.5 1.5 0 0 1 3 0V10m0-1.5a1.5 1.5 0 0 1 3 0V11m0-1a1.5 1.5 0 0 1 3 0v4.5A6.5 6.5 0 0 1 11.5 21h-.6a6 6 0 0 1-4.6-2.2L3.6 15.5a1.6 1.6 0 0 1 2.4-2.1L9 16" /></svg>
          {s.location.hint}
        </p>
        <button type="button" class="recenter" data-recenter>
          <Icon name="home" size={16} />
          {s.location.showVilla}
        </button>
      </div>
    </div>

    <slot />
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: 18px;
    max-width: 760px;
    margin-bottom: clamp(32px, 4vw, 52px);
    justify-items: start;
  }

  .explorer {
    display: grid;
    grid-template-columns: minmax(300px, 380px) 1fr;
    gap: 16px;
    height: 620px;
  }

  .panel {
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: var(--sand-light);
    border-radius: var(--r-md);
    padding: 20px;
  }
  .section--light .panel {
    background: var(--sand);
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--stone);
  }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 14px;
    border-radius: var(--r-pill);
    border: 1px solid var(--stone);
    background: transparent;
    color: var(--ink);
    font: 500 0.86rem/1 var(--font-body);
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }
  .tab:hover {
    border-color: var(--ink-soft);
  }
  .tab[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--sand-light);
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--c, var(--clay));
    flex: none;
  }
  .tab[aria-pressed='true'] .dot {
    box-shadow: 0 0 0 2px var(--sand-light);
  }
  .count {
    min-width: 20px;
    padding: 1px 6px;
    border-radius: 99px;
    background: rgba(51, 41, 31, 0.08);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.5;
    text-align: center;
  }
  .tab[aria-pressed='true'] .count {
    background: rgba(255, 255, 255, 0.18);
  }
  .rating {
    margin-right: 8px;
    color: #a86f16;
    font-weight: 700;
  }
  .item.is-active .rating {
    color: var(--gold);
  }

  .list {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    overflow-y: auto;
    flex: 1;
    min-height: 0;
    scrollbar-width: thin;
  }
  .list li[hidden] {
    display: none;
  }

  .item {
    width: 100%;
    display: grid;
    grid-template-columns: 9px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 13px 12px;
    border: 0;
    border-radius: var(--r-sm);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.95rem;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.2s var(--ease);
  }
  .item:hover {
    background: rgba(51, 41, 31, 0.06);
  }
  .item.is-active {
    background: var(--ink);
    color: var(--sand-light);
  }
  .item.is-active .dist {
    color: var(--on-dark-soft);
  }
  .name {
    font-weight: 500;
    line-height: 1.35;
  }
  .item {
    transition:
      background-color 0.25s var(--ease),
      transform 0.35s var(--spring);
  }
  .item:hover {
    transform: translateX(4px);
  }
  .dist {
    font-size: 0.8rem;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .map-wrap {
    position: relative;
    overflow: hidden;
    background: var(--stone);
    isolation: isolate;
  }
  .map {
    position: absolute;
    inset: 0;
  }

  .recenter {
    position: absolute;
    z-index: 500;
    left: 16px;
    top: 16px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--sand-light);
    color: var(--ink);
    font: 600 0.85rem/1 var(--font-body);
    box-shadow: 0 8px 22px -10px rgba(51, 41, 31, 0.5);
    cursor: pointer;
  }
  .recenter:hover {
    background: #fff;
  }

  .place-card {
    position: absolute;
    z-index: 600;
    left: 16px;
    bottom: 16px;
    width: min(320px, calc(100% - 32px));
    padding: 18px 20px 16px;
    border-radius: 18px;
    background: var(--sand-light);
    box-shadow: 0 20px 44px -18px rgba(51, 41, 31, 0.55);
    font-size: 0.88rem;
    line-height: 1.5;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.4s var(--ease),
      transform 0.5s var(--ease);
  }
  .place-card.is-open {
    opacity: 1;
    transform: none;
  }
  .place-card :global(p) {
    margin: 0;
  }
  .place-card :global(.pop-title) {
    padding-right: 28px;
  }
  .card-close {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 0;
    border-radius: 50%;
    background: rgba(51, 41, 31, 0.07);
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.2s var(--ease);
  }
  .card-close:hover {
    background: rgba(51, 41, 31, 0.14);
  }
  .hint {
    position: absolute;
    z-index: 500;
    left: 16px;
    bottom: 20px;
    max-width: calc(100% - 90px);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px 10px 14px;
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--night) 88%, transparent);
    backdrop-filter: blur(8px);
    color: var(--on-dark);
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.3;
    pointer-events: none;
    box-shadow: 0 12px 28px -12px rgba(0, 0, 0, 0.5);
    transition:
      opacity 0.5s var(--ease),
      transform 0.5s var(--ease);
    animation: hint-in 0.8s var(--ease) 0.6s both;
  }
  .hint svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: tap 1.8s var(--ease) infinite;
  }
  .hint.is-gone {
    opacity: 0;
    transform: translateY(10px);
  }
  @keyframes hint-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @keyframes tap {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    40% {
      transform: translateY(2px) scale(0.88);
    }
  }

  /* --- Leaflet look --- */
  .map :global(.leaflet-tile-pane) {
    filter: sepia(0.12) saturate(0.95) brightness(1.02) hue-rotate(-4deg);
  }
  .map :global(.leaflet-container) {
    font-family: var(--font-body);
  }
  .map :global(.leaflet-control-zoom) {
    border: 0;
    box-shadow: 0 8px 22px -10px rgba(51, 41, 31, 0.5);
    border-radius: 14px;
    overflow: hidden;
  }
  .map :global(.leaflet-control-zoom a) {
    width: 38px;
    height: 38px;
    line-height: 38px;
    background: var(--sand-light);
    color: var(--ink);
    border-color: var(--stone);
  }
  .map :global(.leaflet-control-attribution) {
    background: color-mix(in srgb, var(--sand-light) 85%, transparent);
    font-size: 10px;
  }

  /* Round pins with a category glyph. */
  .map :global(.pin) {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--c);
    color: #fff;
    border: 2.5px solid #fff;
    box-shadow: 0 6px 14px -4px rgba(51, 41, 31, 0.45);
    cursor: pointer;
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease),
      opacity 0.35s var(--ease);
  }
  /* Only when a category is chosen on purpose, never while the map is flying. */
  .map :global(.pin.drop) {
    animation: pin-drop 0.55s var(--ease) both;
    animation-delay: var(--d, 0s);
  }
  .map.is-moving :global(.pin) {
    transition: none;
  }
  .map.has-route :global(.pin:not(.is-active)) {
    opacity: 0.55;
  }
  .map :global(.pin svg) {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .map :global(.pin.is-hover) {
    transform: scale(1.22) translateY(-3px);
    box-shadow: 0 12px 22px -8px rgba(51, 41, 31, 0.6);
  }
  .map :global(.pin.is-active) {
    opacity: 1;
    transform: scale(1.3) translateY(-3px);
    box-shadow:
      0 0 0 6px color-mix(in srgb, var(--c) 30%, transparent),
      0 14px 24px -8px rgba(51, 41, 31, 0.6);
  }
  @keyframes pin-drop {
    from {
      opacity: 0;
      transform: translateY(-18px) scale(0.6);
    }
  }

  .map :global(.leaflet-tooltip.pin-tip) {
    padding: 6px 12px;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--sand-light);
    font: 600 0.8rem/1.2 var(--font-body);
    box-shadow: 0 8px 20px -8px rgba(51, 41, 31, 0.6);
  }
  .map :global(.leaflet-tooltip.pin-tip::before) {
    border-top-color: var(--ink);
  }
  .map :global(.route-line) {
    filter: drop-shadow(0 3px 4px rgba(51, 41, 31, 0.3));
  }
  .map :global(.route-chip) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px 5px 8px;
    border-radius: 99px;
    background: #fff;
    color: var(--ink);
    font: 700 0.78rem/1 var(--font-body);
    white-space: nowrap;
    box-shadow: 0 6px 16px -6px rgba(51, 41, 31, 0.5);
    animation: chip-in 0.45s var(--ease) both;
  }
  .map :global(.route-chip svg) {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: var(--c);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @keyframes chip-in {
    from {
      opacity: 0;
      transform: scale(0.7);
    }
  }
  .map :global(.pop-rating),
  .place-card :global(.pop-rating) {
    margin-left: 8px;
    font-size: 0.75rem;
    font-weight: 700;
    color: #a86f16;
  }

  .map :global(.villa-pin) {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50% 50% 50% 6px;
    rotate: -45deg;
    background: var(--clay);
    box-shadow: 0 8px 20px -6px rgba(181, 83, 47, 0.7);
  }
  .map :global(.villa-pin svg) {
    rotate: 45deg;
    width: 20px;
    height: 24px;
    color: #fff;
  }
  .map :global(.villa-pulse) {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 2px solid var(--clay);
    animation: pulse 2.4s var(--ease) infinite;
  }
  @keyframes pulse {
    from {
      transform: scale(0.6);
      opacity: 0.9;
    }
    to {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  .map :global(.leaflet-popup-content-wrapper) {
    background: var(--sand-light);
    color: var(--ink);
    border-radius: 16px;
    box-shadow: 0 18px 40px -16px rgba(51, 41, 31, 0.5);
  }
  .map :global(.leaflet-popup-tip) {
    background: var(--sand-light);
  }
  .map :global(.leaflet-popup-content) {
    margin: 16px 18px;
    width: 250px;
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .map :global(.pop-title),
  .place-card :global(.pop-title) {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.2;
    margin: 0 0 4px;
  }
  .map :global(.pop-dist),
  .place-card :global(.pop-dist) {
    display: inline-block;
    margin-bottom: 8px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--olive-deep);
  }
  .map :global(.pop-text),
  .place-card :global(.pop-text) {
    margin: 0 0 10px;
    color: var(--ink-soft);
  }
  .map :global(.pop-link),
  .place-card :global(.pop-link) {
    font-weight: 600;
    color: var(--clay);
  }

  .explorer > * {
    min-width: 0;
  }

  @media (max-width: 960px) {
    .explorer {
      grid-template-columns: minmax(0, 1fr);
      height: auto;
    }
    .map-wrap {
      order: -1;
      height: 460px;
    }
    .panel {
      padding: 16px;
    }
    .tabs {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin: 0 -16px;
      padding: 0 16px 14px;
    }
    .tab {
      white-space: nowrap;
    }
    .list {
      max-height: 360px;
    }
  }
</style>

<script>
  type Section = 'food' | 'drinks' | 'nearby' | 'beaches' | 'family' | 'dayTrips' | 'travel';
  interface Place {
    id: string;
    section: Section;
    lat: number;
    lng: number;
    rating?: number;
    title: string;
    distance: string;
    text: string;
  }
  interface Route {
    mode: 'walk' | 'car';
    m: number;
    s: number;
    path: [number, number][];
  }
  interface Config {
    routes: Record<string, Route>;
    initial: Section | 'all';
    villa: { name: string; label: string; lat: number; lng: number; maps: string };
    directions: string;
    colors: Record<Section, string>;
    places: Place[];
  }

  const glyphs: Record<Section, string> = {
    food: '<path d="M7 3v18M4.5 3v4.5a2.5 2.5 0 0 0 5 0V3M17.5 21V3C15.5 4.5 14.5 7 14.5 10v4h3"/>',
    drinks: '<path d="M4.5 4h15L12 12.5zM12 12.5V20M8 20h8"/>',
    nearby: '<path d="M4 20V10l8-6 8 6v10M10 20v-5h4v5"/>',
    beaches: '<path d="M3 15c2-2 4-2 6 0s4 2 6 0 4-2 6 0M3 20c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/><circle cx="16" cy="7" r="2.6"/>',
    family: '<circle cx="12" cy="12" r="8.5"/><path d="M8.5 13.5a4.5 4.5 0 0 0 7 0M9.3 9.5h.01M14.7 9.5h.01"/>',
    dayTrips: '<path d="M3.5 9h17L12 4zM6 9v9M10 9v9M14 9v9M18 9v9M3.5 20.5h17"/>',
    travel: '<path d="M21 4 3 11l7 2.5L12.5 21z"/><path d="m10 13.5 4-4"/>',
  };
  const modeIcons = {
    walk: '<svg viewBox="0 0 24 24"><circle cx="13" cy="4.5" r="1.8"/><path d="M10 21l2-6-2.5-2.5L11 8l3 3 3 1M9.5 12.5 7 14M12 15l3 6"/></svg>',
    car: '<svg viewBox="0 0 24 24"><path d="M5 16V11l2-5h10l2 5v5M5 16h14M5 16v2M19 16v2M5 11h14"/><circle cx="8" cy="13.5" r=".6"/><circle cx="16" cy="13.5" r=".6"/></svg>',
  };
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const archSvg =
    '<svg viewBox="0 0 32 40" aria-hidden="true"><path d="M4 38V18C4 10 9.4 4 16 4s12 6 12 14v20" fill="none" stroke="currentColor" stroke-width="3"/><path d="M10 38V22c0-4 2.7-7 6-7s6 3 6 7v16" fill="currentColor"/></svg>';

  async function init(root: HTMLElement) {
    const cfg: Config = JSON.parse(root.dataset.config!);
    const { default: L } = await import('leaflet');
    const mapEl = root.querySelector<HTMLElement>('[data-map]')!;
    const listEl = root.querySelector<HTMLElement>('[data-list]')!;
    const items = new Map<string, HTMLButtonElement>();
    root.querySelectorAll<HTMLButtonElement>('[data-place]').forEach((b) => items.set(b.dataset.place!, b));
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];

    const villaLL = L.latLng(cfg.villa.lat, cfg.villa.lng);
    const map = L.map(mapEl, { scrollWheelZoom: false, zoomControl: false, attributionControl: true });
    L.control.zoom({ position: 'bottomright' }).addTo(map);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);

    // A small "tap or drag" hint until the visitor first touches the map.
    const hint = root.querySelector<HTMLElement>('[data-hint]');
    const hideHint = () => hint?.classList.add('is-gone');
    map.on('dragstart popupopen', hideHint);
    mapEl.addEventListener('pointerdown', hideHint, { once: true });

    // Scroll-wheel zoom only after the visitor clicks the map, so the page scroll is never hijacked.
    map.on('click', () => map.scrollWheelZoom.enable());
    mapEl.addEventListener('mouseleave', () => map.scrollWheelZoom.disable());

    const villaMarker = L.marker(villaLL, {
      icon: L.divIcon({ className: '', html: `<span class="villa-pin"><span class="villa-pulse"></span>${archSvg}</span>`, iconSize: [46, 46], iconAnchor: [23, 46], popupAnchor: [0, -44] }),
      zIndexOffset: 1000,
      keyboard: true,
      title: cfg.villa.name,
    })
      .addTo(map)
      .bindPopup(
        `<p class="pop-title">${esc(cfg.villa.name)}</p><p class="pop-text">${esc(cfg.villa.label)}</p><a class="pop-link" href="${esc(cfg.villa.maps)}" target="_blank" rel="noopener">Google Maps ↗</a>`,
      );

    const markers = new Map<string, L.Marker>();
    const popups = new Map<string, string>();
    let moving = false;
    map.on('movestart zoomstart', () => {
      moving = true;
      mapEl.classList.add('is-moving');
      mapEl.querySelectorAll('.pin.is-hover').forEach((el) => el.classList.remove('is-hover'));
    });
    map.on('moveend zoomend', () => {
      moving = false;
      mapEl.classList.remove('is-moving');
    });
    for (const p of cfg.places) {
      const dir = `https://www.google.com/maps/dir/?api=1&origin=${cfg.villa.lat},${cfg.villa.lng}&destination=${p.lat},${p.lng}`;
      const rating = p.rating ? `<span class="pop-rating">★ ${p.rating.toFixed(1)}</span>` : '';
      const m = L.marker([p.lat, p.lng], {
        icon: L.divIcon({
          className: '',
          html: `<span class="pin" style="--c:${cfg.colors[p.section]};--d:${(Math.random() * 0.25).toFixed(2)}s"><svg viewBox="0 0 24 24">${glyphs[p.section]}</svg></span>`,
          iconSize: [34, 34],
          iconAnchor: [17, 17],
          popupAnchor: [0, -14],
          tooltipAnchor: [0, -18],
        }),
        keyboard: true,
        alt: p.title,
      })
        .bindTooltip(esc(p.title), { direction: 'top', className: 'pin-tip', offset: [0, -2] });
      popups.set(
        p.id,
        `<p class="pop-title">${esc(p.title)}</p><span class="pop-dist">${esc(p.distance)}</span>${rating}<p class="pop-text">${esc(p.text)}</p><a class="pop-link" href="${dir}" target="_blank" rel="noopener">${esc(cfg.directions)} ↗</a>`,
      );
      m.on('click', () => select(p.id));
      // Ignore pins sliding under a still mouse while the map flies: that is what made them jitter.
      m.on('mouseover', () => {
        if (moving) return;
        items.get(p.id)?.classList.add('is-hover');
        pinOf(p.id)?.classList.add('is-hover');
      });
      m.on('mouseout', () => {
        items.get(p.id)?.classList.remove('is-hover');
        pinOf(p.id)?.classList.remove('is-hover');
      });
      markers.set(p.id, m);
    }

    const pinOf = (id: string) => markers.get(id)?.getElement()?.querySelector('.pin');
    let current: Section | 'all' = cfg.initial;
    let active: string | null = null;

    function setActive(id: string | null) {
      if (active) {
        items.get(active)?.classList.remove('is-active');
        pinOf(active)?.classList.remove('is-active');
      }
      active = id;
      if (id) {
        items.get(id)?.classList.add('is-active');
        pinOf(id)?.classList.add('is-active');
      }
    }

    function filter(section: Section | 'all', fit = true) {
      clearRoute();
      hideCard();
      current = section;
      tabs.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.tab === section)));
      const visible = cfg.places.filter((p) => section === 'all' || p.section === section);
      const ids = new Set(visible.map((p) => p.id));
      for (const [id, m] of markers) {
        if (ids.has(id) && !map.hasLayer(m)) {
          m.addTo(map);
          if (fit && !reduceMotion) {
            const pin = pinOf(id);
            pin?.classList.add('drop');
            pin?.addEventListener('animationend', () => pin.classList.remove('drop'), { once: true });
          }
        } else if (!ids.has(id)) m.remove();
        const li = items.get(id)?.parentElement;
        if (li) li.hidden = !ids.has(id);
      }
      if (active && !ids.has(active)) setActive(null);
      map.closePopup();
      if (fit) {
        const bounds = L.latLngBounds([villaLL, ...visible.map((p) => L.latLng(p.lat, p.lng))]);
        map.flyToBounds(bounds, { padding: [48, 48], maxZoom: 15, duration: 0.8 });
      }
    }

    // ---- place card in the corner of the map ----
    const card = root.querySelector<HTMLElement>('[data-card]')!;
    const cardBody = root.querySelector<HTMLElement>('[data-card-body]')!;
    function showCard(id: string) {
      cardBody.innerHTML = popups.get(id)!;
      card.hidden = false;
      requestAnimationFrame(() => card.classList.add('is-open'));
    }
    function hideCard() {
      card.classList.remove('is-open');
      card.hidden = true;
    }
    root.querySelector('[data-card-close]')!.addEventListener('click', () => {
      clearRoute();
      hideCard();
      setActive(null);
    });

    // ---- route from the villa, drawn like a pen stroke ----
    let routeLayers: L.Layer[] = [];
    let drawToken = 0;
    function clearRoute() {
      drawToken++;
      routeLayers.forEach((l) => l.remove());
      routeLayers = [];
      mapEl.classList.remove('has-route');
    }

    function drawRoute(p: Place, done: () => void) {
      const r = cfg.routes[p.id];
      const color = cfg.colors[p.section];
      const latlngs = r ? r.path : [[cfg.villa.lat, cfg.villa.lng] as [number, number], [p.lat, p.lng] as [number, number]];
      const token = ++drawToken;
      const casing = L.polyline(latlngs, { color: '#fff', weight: 9, opacity: 0.95, lineCap: 'round', lineJoin: 'round', interactive: false });
      const line = L.polyline(latlngs, {
        color,
        weight: 4.5,
        lineCap: 'round',
        lineJoin: 'round',
        interactive: false,
        className: 'route-line',
      });
      routeLayers.push(casing.addTo(map), line.addTo(map));
      mapEl.classList.add('has-route');

      const paths = [casing, line].map((l) => (l as any)._path as SVGPathElement);
      const len = Math.max(...paths.map((el) => el.getTotalLength()));
      const ms = reduceMotion ? 0 : Math.min(1800, 500 + len * 1.4);
      for (const el of paths) {
        el.style.strokeDasharray = `${len} ${len}`;
        el.style.strokeDashoffset = String(len);
        el.getBoundingClientRect();
        el.style.transition = `stroke-dashoffset ${ms}ms cubic-bezier(0.45, 0, 0.2, 1)`;
        el.style.strokeDashoffset = '0';
      }
      setTimeout(() => {
        if (token !== drawToken) return;
        // Clear the dash so later zooming redraws the line normally.
        for (const el of paths) {
          el.style.transition = '';
          el.style.strokeDasharray = '';
          el.style.strokeDashoffset = '';
        }
        if (r) {
          const mid = latlngs[Math.floor(latlngs.length / 2)];
          const dist = (r.m / 1000).toLocaleString(document.documentElement.lang, { maximumFractionDigits: 1, minimumFractionDigits: r.m < 10000 ? 1 : 0 });
          const chip = L.marker(mid, {
            interactive: false,
            keyboard: false,
            icon: L.divIcon({ className: '', html: `<span class="route-chip" style="--c:${color}">${modeIcons[r.mode]}${dist} km · ${Math.max(1, Math.round(r.s / 60))}′</span>`, iconSize: [0, 0] }),
          });
          routeLayers.push(chip.addTo(map));
        }
        done();
      }, ms + 60);
    }

    function select(id: string, fly = true) {
      const p = cfg.places.find((x) => x.id === id);
      const m = markers.get(id);
      if (!p || !m) return;
      if (current !== 'all' && current !== p.section) filter(p.section, false);
      clearRoute();
      map.closePopup();
      showCard(id);
      hideHint();
      setActive(id);
      const btn = items.get(id);
      if (btn) listEl.scrollTo({ top: btn.offsetTop - listEl.offsetTop - 60, behavior: 'smooth' });
      const r = cfg.routes[id];
      const bounds = L.latLngBounds(r ? r.path : [[cfg.villa.lat, cfg.villa.lng], [p.lat, p.lng]]);
      const token = drawToken;
      // Keep the route clear of the card: beside it on wide maps, above it on narrow ones.
      const wide = mapEl.clientWidth > 640;
      const padTL: [number, number] = wide ? [card.offsetWidth + 50, 50] : [36, 50];
      const padBR: [number, number] = wide ? [70, 40] : [36, card.offsetHeight + 36];
      map.flyToBounds(bounds, { paddingTopLeft: padTL, paddingBottomRight: padBR, maxZoom: 16, duration: fly && !reduceMotion ? 0.9 : 0 });
      map.once('moveend', () => {
        if (token === drawToken) drawRoute(p, () => {});
      });
    }

    tabs.forEach((t) => t.addEventListener('click', () => filter(t.dataset.tab as Section | 'all')));
    items.forEach((btn, id) => {
      btn.addEventListener('click', () => select(id));
      btn.addEventListener('mouseenter', () => pinOf(id)?.classList.add('is-hover'));
      btn.addEventListener('mouseleave', () => pinOf(id)?.classList.remove('is-hover'));
    });
    root.querySelector('[data-recenter]')?.addEventListener('click', () => {
      clearRoute();
      hideCard();
      setActive(null);
      map.flyTo(villaLL, 14, { duration: 0.8 });
      map.once('moveend', () => villaMarker.openPopup());
    });

    // Other parts of the page (e.g. Explore cards) can ask the map to show a place.
    window.addEventListener('explorer:select', (e) => {
      mapEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(() => select((e as CustomEvent<string>).detail), 450);
    });

    map.setView(villaLL, 13);
    filter(cfg.initial, false);
    const start = cfg.places.filter((p) => cfg.initial === 'all' || p.section === cfg.initial);
    map.fitBounds(L.latLngBounds([villaLL, ...start.map((p) => L.latLng(p.lat, p.lng))]), { padding: [48, 48], maxZoom: 15 });
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-explorer]')) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          init(root);
        }
      },
      { rootMargin: '400px 0px' },
    );
    io.observe(root);
  }
</script>
