---
import Base from '../../layouts/Base.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const p = t(locale).privacy;
---

<Base locale={locale} path="/privacy/" title={`${p.title} · Belle Helene Villas`} description={p.body[0]}>
  <section class="section">
    <div class="wrap narrow">
      <h1>{p.title}</h1>
      <div class="prose">
        {p.body.map((para) => <p>{para}</p>)}
      </div>
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 760px;
    display: grid;
    gap: 36px;
  }
  h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
  }
  .prose {
    color: var(--ink-soft);
  }
</style>
