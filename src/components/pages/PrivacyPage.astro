---
import Base from '../../layouts/Base.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const p = t(locale).privacy;
---

<Base locale={locale} path="/privacy/" title={`${p.title} · Belle Helene Villas`} description={p.lead}>
  <section class="section">
    <div class="wrap narrow">
      <header class="head">
        <h1>{p.title}</h1>
        <p class="lead">{p.lead}</p>
        <small>{p.updated}</small>
      </header>
      <div class="sections">
        {
          p.sections.map((sec) => (
            <section>
              <h2>{sec.title}</h2>
              <p>{sec.text}</p>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 820px;
    display: grid;
    gap: clamp(36px, 5vw, 56px);
  }
  .head {
    display: grid;
    gap: 16px;
  }
  h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
  }
  small {
    color: var(--ink-soft);
    font-size: 0.88rem;
  }
  .sections {
    display: grid;
    gap: 8px;
  }
  .sections section {
    display: grid;
    grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
    gap: 12px 40px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }
  h2 {
    font-size: 1.15rem;
    line-height: 1.35;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .sections p {
    color: var(--ink-soft);
  }
  @media (max-width: 720px) {
    .sections section {
      grid-template-columns: 1fr;
    }
  }
</style>
