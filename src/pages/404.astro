---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { t } from '../i18n';

const s = t('en').notFound;
---

<Base locale="en" path="/" title={`${s.title} · Belle Helene Villas`} description={s.text}>
  <meta name="robots" content="noindex" slot="head" />
  <section class="section">
    <div class="wrap nf">
      <span class="code">404</span>
      <h1>{s.title}</h1>
      <p class="lead">{s.text}</p>
      <a class="btn btn--primary" href="/">{s.back}<Icon name="arrow" size={18} /></a>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: 20px;
    justify-items: start;
    min-height: 50vh;
    align-content: center;
  }
  .code {
    font-family: var(--font-display);
    font-size: clamp(5rem, 14vw, 10rem);
    line-height: 1;
    color: var(--clay-soft);
  }
</style>
